# ---- Server ----
PORT=8787

# Realtime polling intervals (ms)
QUOTE_POLL_MS=3000
REGIME_POLL_MS=15000
SECTOR_POLL_MS=30000

# Exit engine thresholds
EXIT_TRAIL_PCT=0.0015   # 0.15% trailing take-profit drawdown from peak
EXIT_STOPLOSS_PCT=0.03  # 3% hard stop loss from entry

# ---- OpenAI ----
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1
# Optional: stabilises prompt-cache routing
OPENAI_PROMPT_CACHE_KEY=a-shares-helper-v1

# ---- Optional data source enhancement (Layer 2/3) ----
# If set, enables Tushare as a fallback for breadth / sector data.
TUSHARE_TOKEN=

# Persistence (sqlite file path, relative to server cwd; Docker overrides to /app/data/app.sqlite)
DB_PATH=./data/app.sqlite

# ---- Single-host production (Docker / PM2) ----
# In production the backend ALSO serves the built web UI on PORT, so you only
# expose one port. Leave WEB_DIST empty to auto-resolve ../web/dist.
# WEB_DIST=
